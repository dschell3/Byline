# SCRUM-62: every variable the app reads, with safe placeholder values.
# Copy this file to .env and edit if you need to. Never commit .env.
#
#   cp .env.example .env

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=byline
POSTGRES_PASSWORD=byline
POSTGRES_DB=byline

# --- API ---
# The one variable api/config.py reads. This localhost form is for running
# the API directly on your laptop (see api/README.md). Inside Docker,
# docker-compose overrides it to point at the "db" container instead.
DATABASE_URL=postgresql://byline:byline@localhost:5432/byline

# --- SCRUM-10 password reset email ---
# Configure an SMTP provider before enabling real email delivery.
RESET_SMTP_HOST=
RESET_SMTP_PORT=587
RESET_SMTP_USERNAME=
RESET_SMTP_PASSWORD=
RESET_FROM_EMAIL=
RESET_WEB_BASE_URL=
RESET_SMTP_STARTTLS=true